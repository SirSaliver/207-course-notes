@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}


@startuml

abstract class Item {
    - title : String
    - catalogueNumber : String
    + getTitle() : String
    + getCatalogueNumber() : String
}

interface Borrowable {
    + borrow() : void
    + isOnLoan() : boolean
    + getLoanPeriodDays() : int
}

class Book {
    - onLoan : boolean
    + borrow() : void
    + isOnLoan() : boolean
    + getLoanPeriodDays() : int
}

class DVD {
    - onLoan : boolean
    + borrow() : void
    + isOnLoan() : boolean
    + getLoanPeriodDays() : int
}

class ReferenceOnlyItem {
}

class Member {
    - memberNumber : String
    - lateFee : BigDecimal
    + login(memberNumber : String) : boolean
    + borrow(item : Borrowable) : void
    + placeHold(item : Borrowable) : Hold
    + clearLateFee() : void
}

class Librarian {
    + addItem(item : Item, catalogue : Catalogue) : void
    + waiveLateFee(member : Member) : void
}

class Catalogue {
    + addItem(item : Item) : void
}

class Hold {
}

' Generalization
Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceOnlyItem

' Realization
Borrowable <|.. Book
Borrowable <|.. DVD

' Association
Member "1" -- "0..*" Hold : places
Hold "0..*" --> "1" Borrowable : reserves
Catalogue "1" --> "0..*" Item : contains

' Dependency
Member ..> Borrowable : borrows
Librarian ..> Catalogue : manages
Librarian ..> Member : waives fee

' Constraints
note bottom of Book
    Loan period = 21 days
end note

note bottom of DVD
    Loan period = 7 days
end note

note bottom of Hold
    Item must be on loan
    when a hold is placed.
end note

note bottom of Catalogue
    Catalogue numbers must be unique.
end note

@enduml
